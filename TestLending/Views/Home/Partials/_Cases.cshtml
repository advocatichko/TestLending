<div class="w-100 mt-4">
    <h2 class="fs-4 fw-bold text-center">Реальні кейси</h2>
    <div class="row justify-content-center">
        <div class="col-12 col-md-8">
            <div class="ratio ratio-16x9" id="video-container">
                <iframe 
                    src="https://www.youtube.com/embed/1_wrWBuaZ4o?rel=0" 
                    title="Оскарження штрафу за неявку по повістці" 
                    frameborder="0" 
                    loading="lazy"
                    importance="low"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                    allowfullscreen>
                </iframe>
            </div>
            <div class="text-center mt-2">
                <p class="video-caption">Оскарження штрафу за неявку по повістці</p>
            </div>
        </div>
    </div>
</div>

@{
    var videoJson = @"{
  ""@context"": ""https://schema.org"",
  ""@type"": ""VideoObject"",
  ""name"": ""Оскарження штрафу за неявку по повістці"",
  ""description"": ""Детальна інформація про оскарження штрафів ТЦК в Україні"",
  ""thumbnailUrl"": ""https://img.youtube.com/vi/1_wrWBuaZ4o/hqdefault.jpg"",
  ""uploadDate"": ""2023-09-15"",
  ""contentUrl"": ""https://www.youtube.com/watch?v=1_wrWBuaZ4o"",
  ""embedUrl"": ""https://www.youtube.com/embed/1_wrWBuaZ4o""
}";
}

<script type="application/ld+json">
@Html.Raw(videoJson)
</script>

<style>
    .video-caption {
        font-weight: bold;
        font-size: 16px;
        color: #333;
        margin-top: 8px;
    }
    
    .ratio-16x9 {
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        will-change: contents;
    }
    
    #video-container {
        contain: layout paint;
    }
    
    /* Make sure that #main-description has appropriate styling for LCP performance */
    .header-description {
        max-width: 100%;
        font-size: 1.1rem !important;
        font-weight: 400;
        text-align: center;
        line-height: 1.5;
    }
</style>