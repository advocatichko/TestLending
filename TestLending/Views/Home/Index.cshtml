@using static TestLending.Models.Models
@model List<PageData>
@{
    var leng = ViewBag.Cookie;
    ViewData["Title"] = "Оскарження штрафу ТЦК";
    var headerData = Model.Where(x => x.SectionName == "Header").ToList();
    var headerTitle = headerData.Where(x => x.SectionContentType == "Title").FirstOrDefault();
    var headerDescr = headerData.Where(x => x.SectionContentType == "Description").FirstOrDefault();
    var headerButton = headerData.Where(x => x.SectionContentType == "Button Text").FirstOrDefault();
    ViewData["HeaderTitle"] = leng == "ua" ? headerTitle?.ua ?? "" : headerTitle?.en ?? "";
    ViewData["HeaderDescription"] = leng == "ua" ? headerDescr?.ua ?? "" : headerDescr?.en ?? "";
    ViewData["HeaderButton"] = leng == "ua" ? headerButton?.ua ?? "" : headerButton?.en ?? "";
    // string advokatinlaw = "advokatinlaw";
}

