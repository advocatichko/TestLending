<div class="mt-5">
    @{
        var shlT = Model.Where(x => x.SectionName == "Seeking Help from a Lawyer" && x.SectionContentType == "Title").FirstOrDefault();
        var shlD = Model.Where(x => x.SectionName == "Seeking Help from a Lawyer" && x.SectionContentType == "Description").FirstOrDefault();
        var shlF = Model.Where(x => x.SectionName == "Seeking Help from a Lawyer" && x.SectionContentType == "Footer descr").FirstOrDefault();
    }
    <section class="section mb-3">
        <h2>@(leng == "ua" ? shlT?.ua ?? "" : shlT?.en ?? "")</h2>
    </section>

    <p>@(leng == "ua" ? shlD?.ua ?? "" : shlD?.en ?? "")</p>
    <ul>
        @for (var i = 0; i <= Model.Where(x => x.SectionName == "Seeking Help from a Lawyer").Max(x => x.Order); ++i)
        {
            var tT = Model.Where(x => x.Order == i && x.SectionName == "Seeking Help from a Lawyer" && x.SectionContentType == "Block title").FirstOrDefault();
            var tS = Model.Where(x => x.Order == i && x.SectionName == "Seeking Help from a Lawyer" && x.SectionContentType == "Block description").FirstOrDefault();
            if (tT != null && tS != null) {
                <li><strong>@(leng == "ua" ? tT.ua : tT.en)</strong> @(leng == "ua" ? tS.ua : tS.en)</li>
            }
        }
      @*   <li><strong>Консультації з питань оскарження штрафів:</strong> Довідки про ваші права та обов'язки, а також рекомендації по діям.</li>
        <li><strong>Підготовка документації:</strong> Наша команда підготує всі необхідні юридичні документи для вашого випадку.</li>
        <li><strong>Представництво ваших інтересів у суді:</strong> У разі потреби, ми будемо представляти вас в судових установах та захищати ваші права.</li>
        <li><strong>Супровід переговорів з державними органами:</strong> Можливість ведення переговорів від вашого імені для досягнення кращого результату.</li> *@
    </ul>
    <p>@(leng == "ua" ? shlF?.ua ?? "" : shlF?.en ?? "")</p>
   
</div>
<div class="d-flex justify-content-around">
</div>
<!-- Modal -->
<div class="modal fade" id="orderFormModal" tabindex="-1" aria-labelledby="orderFormModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="orderFormModalLabel">Замовити оскарження</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="orderForm" method="post" action="/Home/SubmitOrder">
                    <div class="mb-3">
                        <label for="fullName" class="form-label">П.І.Б.</label>
                        <input type="text" class="form-control" id="fullName" name="fullName" required>
                    </div>
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label">Номер телефону</label>
                        <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" value="+38" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" required>
                    </div>
                    <button type="submit" class="btn btn-blue">Відправити</button>
                </form>
                <div id="successMessage" class="alert alert-success mt-3" style="display: none;">
                    Заявка відправлена!
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const phoneInput = document.getElementById("phoneNumber");

        phoneInput.addEventListener("input", function (e) {
            let value = phoneInput.value.replace(/\D/g, ""); // Убираем всё, кроме цифр

            if (value.startsWith("38")) value = value.substring(2); // Убираем дублирование кода страны

            let formatted = "+38 ";

            if (value.length > 0) formatted += value.substring(0, 3);
            if (value.length > 3) formatted += " " + value.substring(3, 6);
            if (value.length > 6) formatted += " " + value.substring(6, 8);
            if (value.length > 8) formatted += " " + value.substring(8, 10);

            phoneInput.value = formatted;
        });
    });
</script>
