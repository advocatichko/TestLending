<!DOCTYPE html>
<html lang="uk" class="fonts-loading">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Оскарження адміністративних постанов</title>
    
    <!-- Inline critical CSS -->
    @await Html.PartialAsync("_CriticalCss")
    
    <!-- Add content-visibility auto CSS for below-the-fold content -->
    <style>
        /* Add styles to prevent layout shifts */
        .fonts-loading * {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif !important;
        }
        
        .fonts-loaded * {
            /* Restore the Unbounded font once loaded */
            font-family: 'Unbounded', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
        }
        
        /* Reserve space for images to prevent layout shifts */
        img {
            aspect-ratio: attr(width) / attr(height);
        }
        
        /* Add explicit dimensions to containers that might shift */
        .header-container {
            contain: layout size;
            content-visibility: auto;
            contain-intrinsic-size: 0 400px;
        }
        
        /* Apply content-visibility to below-the-fold sections */
        .below-fold {
            content-visibility: auto;
            contain-intrinsic-size: 0 300px;
        }
    </style>
    
    <!-- Non-critical CSS loading with resource hints -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Async CSS loading -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/TestLending.styles.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/lib/fontawesome-free-6.7.2-web/css/fontawesome.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/lib/fontawesome-free-6.7.2-web/css/solid.css" media="print" onload="this.media='all'" />
    
    <!-- Fallbacks for browsers with JS disabled -->
    <noscript>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/TestLending.styles.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/lib/fontawesome-free-6.7.2-web/css/fontawesome.css" />
        <link rel="stylesheet" href="~/lib/fontawesome-free-6.7.2-web/css/solid.css" />
    </noscript>
    
    <!-- Defer non-critical scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/inputmask/5.0.8/inputmask.min.js" defer></script>
</head>
