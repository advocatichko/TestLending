    <script>
        // Font loading optimization
        document.addEventListener('DOMContentLoaded', function() {
            // Priority loading for LCP element
            const lcpElement = document.getElementById('main-description');
            if (lcpElement) {
                lcpElement.style.display = 'block';
                lcpElement.style.visibility = 'visible';
            }
            
            // Font loading optimization
            if (!sessionStorage.fontsLoaded) {
                const fontFaceObserver = function(fontFamily) {
                    return new Promise(function(resolve, reject) {
                        const fontLoader = new FontFaceObserver(fontFamily);
                        Promise.all([
                            fontLoader.load('400px'),
                            fontLoader.load('700px')
                        ]).then(function() {
                            resolve();
                        }).catch(function() {
                            // Still resolve even if font loading fails
                            resolve();
                        });
                    });
                };
                
                // Wait for main font to load
                Promise.all([
                    fontFaceObserver('Unbounded')
                ]).then(function() {
                    document.documentElement.classList.add('fonts-loaded');
                    document.documentElement.classList.remove('fonts-loading');
                    sessionStorage.fontsLoaded = true;
                }).catch(function() {
                    // Fallback to system fonts if custom fonts fail
                    document.documentElement.classList.remove('fonts-loading');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    
